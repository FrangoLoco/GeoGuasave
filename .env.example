# Copiar a .env y cambiar la contraseña. .env nunca se sube a git.
POSTGRES_DB=geoguasave
POSTGRES_USER=geoguasave
POSTGRES_PASSWORD=cambia_esto
# Puerto del host donde se publica PostgreSQL (solo en 127.0.0.1).
DB_PORT=5432
# Puerto del host donde se publica la API (solo en 127.0.0.1).
API_PORT=8000
# Distancia máxima, en metros, a una localidad puntual (regla 1.3).
LPR_MAX_DIST_M=500
